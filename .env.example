# Database
DATABASE_URL=postgresql://user:password@localhost:5432/kaizou

# Authentication (learner)
JWT_SECRET=your-jwt-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Admin (management portal) auth — a SEPARATE signing key from JWT_SECRET, so a
# learner token can never be used against admin routes. Generate 32 random bytes.
ADMIN_JWT_SECRET=your-separate-admin-secret-here
# Secret, non-obvious base path for the admin API (must NOT be /api/management).
# The portal calls this base; learners never see it (unknown paths 404).
ADMIN_API_BASE=/api/_ctrl

# Global site gate: one shared username/password everyone enters before the
# learner app loads at all (a dev-site splash gate, not per-user identity).
GATE_USERNAME=kaizou
GATE_PASSWORD=change-me
GATE_TOKEN_EXPIRY=12h

# OAuth - GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Server
PORT=3000
# Comma-separated allowlist: Kaizou frontend, management portal
CORS_ORIGIN=http://localhost:8443,http://localhost:5174

# FastAPI Backend
# AI provider keys (Jev, Anthropic, Gemini) do NOT belong here. They live only
# in fastapi/.env. Express proxies to FastAPI and never holds them.
FASTAPI_URL=http://localhost:8000
# Shared secret sent as X-Internal-Key on Express -> FastAPI ingest calls
INTERNAL_API_KEY=
# Idle time before a saved note is sent for ingestion
INGEST_DEBOUNCE_MS=15000

# Frontend URLs
FRONTEND_URL=http://localhost:8443

# OAuth callback base: where the provider sends the user back to Express.
# Callbacks become ${OAUTH_CALLBACK_BASE}/api/oauth/github/callback and
# ${OAUTH_CALLBACK_BASE}/api/oauth/google/callback; register exactly these
# URLs with GitHub/Google.
OAUTH_CALLBACK_BASE=http://localhost:3000

# Database TLS: certificates are verified by default (Neon has publicly
# trusted certs). Set to false ONLY for a local DB with a self-signed cert.
# To disable TLS entirely for a local DB, add ?sslmode=disable to DATABASE_URL.
DB_SSL_REJECT_UNAUTHORIZED=true
