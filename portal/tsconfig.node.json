{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "strict": true,
    /* Type-check only: never emit vite.config.js, which Vite would load instead of the .ts */
    "noEmit": true
  },
  "include": ["vite.config.ts"]
}
