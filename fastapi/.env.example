# Copy to .env (same folder) and fill in. Never commit .env.
# All AI keys live ONLY here, in the FastAPI backend. Express and the
# frontends never receive them. See ../AI_PROVIDER_DECISIONS.md.

DATABASE_URL=postgresql://user:password@localhost:5432/kaizou
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
EXPRESS_BASE_URL=http://localhost:3000
# Shared secret for Express -> FastAPI calls, sent as X-Internal-Key.
# REQUIRED: every FastAPI route rejects calls without it (401). Must equal
# INTERNAL_API_KEY in the root .env. Generate: python -c "import secrets;print(secrets.token_hex(32))"
INTERNAL_API_KEY=
# Local experiments only: accept calls when INTERNAL_API_KEY is blank. Never in deployment.
ALLOW_UNAUTHENTICATED_INTERNAL=false
# Comma-separated browser origins allowed to call FastAPI directly (normally only Express calls it)
FASTAPI_CORS_ORIGINS=http://localhost:3000

# --- Classification: Jev (TypeSafe AI) --------------------------------------
# Bounded-choice decisions: track / shape / category / Bloom prior.
# "typesafe": TypeSafe's own console key (what this project uses).
# "openrouter": alternative, billed to an OpenRouter account.
JEV_BACKEND=typesafe
# Needed when JEV_BACKEND=typesafe. https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
# Needed only when JEV_BACKEND=openrouter. https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Blank = pinned default (jev-latest native, typesafe/jev-1.13 on OpenRouter)
JEV_MODEL=

# --- Generation: Gemini Flash (default) -------------------------------------
# Structured content: claims, prerequisites, templates, probes, etc.
# "gemini" is the default. "anthropic" (Claude) is optional and off by default.
GENERATION_PROVIDER=gemini
GEMINI_GENERATION_MODEL=gemini-3.8-flash
# low | medium | high | xhigh | max (thinking depth). Lower = cheaper.
GENERATION_EFFORT=medium
# Hard cap on thinking + output tokens per call
GENERATION_MAX_TOKENS=16000
# Gemini thinking depth: minimal | low | medium | high. Blank = model default. Lower = cheaper.
GEMINI_THINKING_LEVEL=
# Only used if you deliberately switch GENERATION_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# --- Embeddings -------------------------------------------------------------
# One Google key covers embeddings AND Gemini generation.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
# Must equal the vector(N) columns in database/schema.sql. Changing the model
# or this value requires re-embedding every stored claim and concept.
EMBEDDING_DIMENSIONS=1536

# --- Budget cap, ledger, cache (protects your credits) ----------------------
# Hard ceiling on cumulative ESTIMATED AI spend. When reached, paid calls are
# refused (HTTP 402); deterministic grading/graph/memory keep working.
# This is a ceiling, not a prepaid amount.
AI_BUDGET_INR=2000
# Above this fraction of the cap, optional work (benchmarking) is skipped.
AI_BUDGET_SOFT_FRACTION=0.80
# USD->INR used to convert provider prices. Update with the rate + date.
USD_INR_RATE=96
# Spend ledger and reuse cache. Leave on unless debugging.
AI_LEDGER_ENABLED=true
AI_CACHE_ENABLED=true
# Bump to invalidate cached generations after a prompt/schema change.
AI_PROMPT_VERSION=v1

# --- Provider HTTP behaviour ------------------------------------------------
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_MAX_RETRIES=3

# --- Local NLI (contradiction detection) — CPU, no API, no learner data leaves --
# Runs the contradiction check locally. PROVISIONAL model choice — confirm with
# a project benchmark before shipping. Needs the optional extra: pip install -e ".[nli]"
# Load it in ONE process (the worker), not multiple web workers (~1 GB each).
NLI_ENABLED=true
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
NLI_REVISION=b5113eb38ab63efdd7f280f8c144ea8b13f978ce
NLI_DEVICE=cpu
NLI_MAX_LENGTH=256
NLI_BATCH_SIZE=16
NLI_PREPROCESSING_VERSION=v1
# Load the NLI model in the background at startup instead of on first use
NLI_PRELOAD=false

# --- Source search (optional, /retrieval/search) ------------------------------
# Google Programmable Search. Blank = search disabled (returns configured:false).
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=


# Second line of defense: also set a BUDGET ALERT in Google Cloud (e.g. ₹500)
# on the project behind GEMINI_API_KEY, and enable PAID billing before
# embedding real learner notes (free tier reuses your content).
