# Copy to .env (same folder) and fill in. Never commit .env.
# All AI keys live ONLY here, in the FastAPI backend. Express and the
# frontends never receive them. See ../AI_PROVIDER_DECISIONS.md.

DATABASE_URL=postgresql://user:password@localhost:5432/kaizou
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
EXPRESS_BASE_URL=http://localhost:3000
# Shared secret for Express -> FastAPI calls (blank = dev mode, allow all)
INTERNAL_API_KEY=

# --- Classification: Jev (TypeSafe AI) --------------------------------------
# Bounded-choice decisions: track / shape / category / Bloom prior.
# "openrouter" (default): no waitlist, billed to your OpenRouter account.
# "typesafe": TypeSafe's own console (early access may be waitlisted).
JEV_BACKEND=openrouter
# Needed when JEV_BACKEND=openrouter. https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Needed when JEV_BACKEND=typesafe. https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
# Blank = pinned default (typesafe/jev-1.13 on OpenRouter, jev-latest native)
JEV_MODEL=

# --- Generation: primary LLM ------------------------------------------------
# Structured content: claims, prerequisites, templates, probes, etc.
# "anthropic" = primary (default). "gemini" = secondary, benchmarking only.
GENERATION_PROVIDER=anthropic
# Claude API key. https://platform.claude.com/settings/keys (billing required)
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (controls adaptive thinking depth)
GENERATION_EFFORT=medium
# Hard cap on thinking + output tokens per call
GENERATION_MAX_TOKENS=16000
# Used only when GENERATION_PROVIDER=gemini (reuses GEMINI_API_KEY below)
GEMINI_GENERATION_MODEL=gemini-3.8-flash

# --- Embeddings -------------------------------------------------------------
# One Google key covers embeddings AND the optional Gemini secondary generator.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
# Must equal the vector(N) columns in database/schema.sql. Changing the model
# or this value requires re-embedding every stored claim and concept.
EMBEDDING_DIMENSIONS=1536

# --- Provider HTTP behaviour ------------------------------------------------
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_MAX_RETRIES=3

# --- Local models (not API providers) ---------------------------------------
# Contradiction detection runs locally on this NLI model, never on an LLM.
NLI_MODEL=cross-encoder/nli-deberta-v3-base
